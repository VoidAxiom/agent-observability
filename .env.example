# ClickHouse local instance (VOI-306)
CH_HOST=localhost
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9000
CH_DATABASE=default
CH_USERNAME=default
CH_PASSWORD=

# OTel Collector local endpoint (VOI-307)
OTLP_GRPC_ENDPOINT=localhost:4317
OTLP_HTTP_ENDPOINT=http://localhost:4318

# Python SDK runtime (VOI-308)
# AGENT_OBS_PROJECT defaults to "agent-observability"
# AGENT_OBS_SESSION_ID defaults to a generated uuid4 per process
