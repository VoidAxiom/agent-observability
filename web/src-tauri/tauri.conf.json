{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-observability",
  "version": "0.0.0",
  "identifier": "com.voidaxiom.agent-observability",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
